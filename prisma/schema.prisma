generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  YOUTUBE
  X
  TIKTOK
  INSTAGRAM
  REDDIT
  TELEGRAM
  WEBSITE
}

// Where a partner is in the team's own outreach. Set by hand; the app never contacts anyone.
enum PartnerStage {
  FOUND        // discovered, nobody has reached out yet
  CONTACTED    // the team has contacted them
  IN_PROGRESS  // talking / signing up
  REGISTERED   // signed up as a partner
  DECLINED     // not interested or not a fit
}

model Lead {
  id            String     @id @default(uuid())
  platform      Platform
  handle        String // normalised, lower-case channel / username / domain
  url           String
  displayName   String
  bio           String     @default("")
  followers     Int?
  country       String? // ISO-3166 alpha-2 when known
  language      String?
  contactEmail  String?
  recentContent Json       @default("[]") // [{ title, text, url, publishedAt }]
  source        String // ai-search | youtube-search | url | csv | json
  discoveredAt  DateTime   @default(now())

  stage         PartnerStage @default(FOUND)
  stageNote     String?
  stageBy       String?
  stageAt       DateTime?

  @@unique([platform, handle])
  @@index([discoveredAt])
  @@index([stage])
  @@map("leads")
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  leadId    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("audit_log")
}
