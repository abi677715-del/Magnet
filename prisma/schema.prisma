generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  YOUTUBE
  X
  TIKTOK
  INSTAGRAM
  FACEBOOK
  REDDIT
  TELEGRAM
  WEBSITE
}

// Where a partner is in the team's own outreach. Set by hand; the app never contacts anyone.
enum PartnerStage {
  FOUND        // discovered, nobody has reached out yet
  CONTACTED    // the team has contacted them
  IN_PROGRESS  // talking / signing up
  REGISTERED   // signed up as a partner
  DECLINED     // not interested or not a fit
}

model Lead {
  id            String     @id @default(uuid())
  platform      Platform
  handle        String // normalised, lower-case channel / username / domain
  url           String
  displayName   String
  bio           String     @default("")
  followers     Int?
  country       String? // ISO-3166 alpha-2 when known
  language      String?
  contactEmail  String?
  recentContent Json       @default("[]") // [{ title, text, url, publishedAt }]
  source        String // ai-search | youtube-search | url | csv | json
  discoveredAt  DateTime   @default(now())
  topics        String[]   @default([]) // content topics the partner was found for, e.g. MMA, TENNIS

  stage         PartnerStage @default(FOUND)
  stageNote     String?
  stageBy       String?
  stageAt       DateTime?

  @@unique([platform, handle])
  @@index([discoveredAt])
  @@index([stage])
  @@map("leads")
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  leadId    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("audit_log")
}

// People on the team. They register, then an admin approves them; only approved users can sign in.
enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING   // registered, waiting for an admin
  APPROVED  // can sign in
  REJECTED  // admin said no
  DISABLED  // was approved, now switched off
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique // stored lower-case
  name         String
  passwordHash String // scrypt, never the password itself
  role         UserRole   @default(USER)
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  decidedBy    String?
  decidedAt    DateTime?
  lastLoginAt  DateTime?
  sessions     Session[]

  @@index([status])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique // sha256 of the token; the token itself is never stored
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@map("sessions")
}
