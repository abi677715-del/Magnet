generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  YOUTUBE
  X
  TIKTOK
  INSTAGRAM
  REDDIT
  TELEGRAM
  WEBSITE
}

enum LeadStatus {
  NEW       // discovered, not scored yet
  SCORED    // scored by the AI, waiting for a manager
  APPROVED  // on the manager's shortlist
  REJECTED  // manager said no
}

model Lead {
  id            String     @id @default(uuid())
  platform      Platform
  handle        String // normalised, lower-case channel / username / domain
  url           String
  displayName   String
  bio           String     @default("")
  followers     Int?
  country       String? // ISO-3166 alpha-2 when known
  language      String?
  contactEmail  String?
  recentContent Json       @default("[]") // [{ title, text, url, publishedAt }]
  source        String // youtube-search | url | csv | manual
  discoveredAt  DateTime   @default(now())

  status        LeadStatus @default(NEW)
  score         Int?
  category      String?
  summary       String?
  breakdown     Json? // sub-scores + weights actually used
  strengths     String[]   @default([])
  concerns      String[]   @default([])
  redFlags      String[]   @default([])
  isPriority    Boolean    @default(false)
  scoredAt      DateTime?
  scoreModel    String?
  scoreError    String?

  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?

  @@unique([platform, handle])
  @@index([status, score])
  @@map("leads")
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  leadId    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("audit_log")
}
